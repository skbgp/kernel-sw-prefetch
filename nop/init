#!/bin/sh
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t 9p -o trans=virtio,version=9p2000.L,ro tests /shared || exec sh
printf 'GUEST_KERNEL='
uname -r
printf 'BPF config:\n'
zcat /proc/config.gz | grep -E 'CONFIG_(BPF_SYSCALL|BPF_JIT|TEST_BPF)'
if grep -q 'nop.auto=1' /proc/cmdline; then
    /shared/run.sh
    poweroff -f
fi
printf 'Run /shared/test or /shared/run.sh. Exit with poweroff -f.\n'
exec setsid cttyhack sh
